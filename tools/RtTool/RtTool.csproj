<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>rt</AssemblyName>
    <RootNamespace>RtTool</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same source file the plugin runs, so replays match the driver exactly. -->
    <Compile Include="..\..\src\RapidTrigger\TriggerEngine.cs" Link="TriggerEngine.cs" />
  </ItemGroup>

</Project>
